# ============================================================
# HomeFix — required environment variables
# Copy this file to `.env` (gitignored) or export these in your shell.
# ============================================================

# MySQL credentials (used by every business service)
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT signing key — ONE shared Base64-encoded 256-bit+ key for all services.
# Generate a new one with:  openssl rand -base64 64
JWT_SECRET=

# Razorpay payment keys (payment-service) — get TEST keys from
# https://dashboard.razorpay.com/app/keys (Dashboard > Settings > Keys, Test Mode).
# Never commit real (live) keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
